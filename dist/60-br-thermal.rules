# USB access to supported Brother printers for the br-thermal service
#
# This file is maintained by hand. The product IDs must agree with the USB ID
# tables in src/drivers/td2000/include/td2000.h and
# src/drivers/pte550w/include/pte550w.h.
#
# The rules give the _br-thermal group read and write access to each supported printer.
# The uaccess tag also gives access to the user at the local seat.
# When you connect a printer, the rules start br-thermal-autoadd.service.
#
# The rules apply on "add" and "change" events.
# Thus a "change" trigger applies the permissions to printers that are already connected.
#
# After changes, reload the rules and apply them:
#   udevadm control --reload-rules
#   udevadm trigger --action=change --subsystem-match=usb --attr-match=idVendor=04f9

ACTION!="add|change", GOTO="br_thermal_end"
SUBSYSTEM!="usb", GOTO="br_thermal_end"
ENV{DEVTYPE}!="usb_device", GOTO="br_thermal_end"
ATTR{idVendor}!="04f9", GOTO="br_thermal_end"

# TD-2020
ATTR{idProduct}=="2055", GOTO="br_thermal_match"
# TD-2120N
ATTR{idProduct}=="2057", GOTO="br_thermal_match"
# TD-2130N
ATTR{idProduct}=="2058", GOTO="br_thermal_match"
# TD-2030A
ATTR{idProduct}=="20f6", GOTO="br_thermal_match"
# TD-2125N
ATTR{idProduct}=="20f7", GOTO="br_thermal_match"
# TD-2125NWB
ATTR{idProduct}=="20f8", GOTO="br_thermal_match"
# TD-2135N
ATTR{idProduct}=="20f9", GOTO="br_thermal_match"
# TD-2135NWB
ATTR{idProduct}=="20fa", GOTO="br_thermal_match"
# PT-E550W
ATTR{idProduct}=="2060", GOTO="br_thermal_match"
# PT-P750W
ATTR{idProduct}=="2062", GOTO="br_thermal_match"
# PT-P710BT
ATTR{idProduct}=="2064", GOTO="br_thermal_match"
GOTO="br_thermal_end"

LABEL="br_thermal_match"
GROUP="_br-thermal", MODE="0660", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_WANTS}+="br-thermal-autoadd.service"

LABEL="br_thermal_end"
